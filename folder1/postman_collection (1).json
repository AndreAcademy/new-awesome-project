{
  "info": {
    "name": "BTA Fresh Market API",
    "description": "REST API behind the BTA Fresh Market storefront (BTA QA Testing course). Set baseUrl to your API endpoint. Run \"Auth > Login (standard_user)\" first: it saves the token, which the collection then sends as a Bearer header. Products and Login are public; Cart, Checkout and Orders return 401 without a valid token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://r0w3uq7i2d.execute-api.eu-west-1.amazonaws.com"
    },
    {
      "key": "sessionId",
      "value": "demo-session-1"
    },
    {
      "key": "productId",
      "value": "blueberries"
    },
    {
      "key": "orderId",
      "value": "paste-an-order-id-from-checkout"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/products",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/products/{{productId}}",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (standard_user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"standard_user\",\n  \"password\": \"letmein123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (locked_out_user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"locked_out_user\",\n  \"password\": \"letmein123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/cart/{{sessionId}}"
          }
        },
        {
          "name": "Add item to cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/cart/{{sessionId}}/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
            }
          }
        },
        {
          "name": "Update item quantity",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/cart/{{sessionId}}/items/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1\n}"
            }
          }
        },
        {
          "name": "Remove item",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/cart/{{sessionId}}/items/{{productId}}"
          }
        },
        {
          "name": "Get cart without a token (expect 401)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/v1/cart/{{sessionId}}"
          }
        }
      ]
    },
    {
      "name": "Checkout",
      "item": [
        {
          "name": "Checkout cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"customer\": {\n    \"fullName\": \"Ada Lovelace\",\n    \"email\": \"ada@example.com\",\n    \"address\": \"1 Analytical Engine Way\"\n  }\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Get order by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/orders/{{orderId}}"
          }
        },
        {
          "name": "Get order (not found)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/orders/does-not-exist"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  }
}
